{
  "horizon": 20,
  "state_box": [-1.0, 1.0],
  "search": {
    "screening": "all admissible starts; zero plus 32 deterministic scrambled-Sobol states",
    "other_seeds": {"unique_windows": 300, "initial_population": 22, "first_iterations": 50, "final_windows": 50, "final_iterations": 125},
    "seed_3": {"unique_windows": 1000, "initial_population": 34, "first_iterations": 75, "final_windows": 150, "final_iterations": 250},
    "restart_families": ["screen winner", "zero", "Sobol", "random", "corners", "axis boundary"],
    "learning_rates": [0.01, 0.03, 0.06],
    "optimizer": "projected Adam ascent retaining the best iterate"
  },
  "dtype": "float64",
  "operator_norm": "largest singular value (induced 2-norm)",
