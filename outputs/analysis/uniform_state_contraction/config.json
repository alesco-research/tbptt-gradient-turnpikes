    "train_validation_boundary": "no reset",
    "trajectory_length": 100000,
    "train_length": 80000,
    "validation_length": 20000,
    "normalization": "none",
    "official_test_used": false
  },
  "checkpoint_identifiers": [
    "outputs/bptt/run_seed_001/final_model.pt",
    "outputs/bptt/run_seed_002/final_model.pt",
    "outputs/bptt/run_seed_003/final_model.pt",
    "outputs/bptt/run_seed_004/final_model.pt",
    "outputs/bptt/run_seed_005/final_model.pt"
  ],
  "checkpoint_update": 5000,
